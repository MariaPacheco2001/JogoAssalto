    - target: {fileID: 614018543064522004, guid: 2f9fb55b9a16c2843a19c4be5ddfdf8c, type: 3}
      propertyPath: m_Text
      value: "AVISO DE MANUTEN\xC7\xC3O"
      objectReference: {fileID: 0}
    - target: {fileID: 684966666479234965, guid: 2f9fb55b9a16c2843a19c4be5ddfdf8c, type: 3}
      propertyPath: m_Name
      value: "Mesa com documento \u2014 Aviso de manuten\xE7\xE3o"
      objectReference: {fileID: 0}
    - target: {fileID: 5541964636515123417, guid: 2f9fb55b9a16c2843a19c4be5ddfdf8c, type: 3}
      propertyPath: id
      value: outsideNote
      objectReference: {fileID: 0}
    - target: {fileID: 5541964636515123417, guid: 2f9fb55b9a16c2843a19c4be5ddfdf8c, type: 3}
      propertyPath: text
      value: "O port\xE3o de cargas est\xE1 preso. A equipa deixou o p\xE9-de-cabra na caixa vermelha junto \xE0 fachada sul.\n\nA porta de servi\xE7o, na outra ponta da fachada, abre com a chave do piquete. O arm\xE1rio de chaves fica no exterior, junto \xE0 esquina norte.\n\nN\xE3o confundam os quadros das luzes com a alimenta\xE7\xE3o de reserva do arquivo."
      objectReference: {fileID: 0}
    - target: {fileID: 5541964636515123417, guid: 2f9fb55b9a16c2843a19c4be5ddfdf8c, type: 3}
      propertyPath: label
      value: "Aviso de manuten\xE7\xE3o"
      objectReference: {fileID: 0}
    - target: {fileID: 8289392792115829342, guid: 2f9fb55b9a16c2843a19c4be5ddfdf8c, type: 3}
